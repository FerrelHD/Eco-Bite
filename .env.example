# EcoBite Environment Configuration Template

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Railway)
DATABASE_URL="postgresql://postgres:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="ecobite-super-secure-jwt-secret-key-2026"

# Dynamic QR Code Cryptographic HMAC Signature Key
